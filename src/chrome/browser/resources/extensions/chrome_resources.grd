<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/chrome_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="chrome_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <!-- Add our extension here, among existing includes -->
      <include name="IDR_BUNDLED_EXTENSION" 
               file="extensions/bundled_extension.crx" 
               type="BINDATA" 
               compress="gzip" />
      
      <!-- Existing includes continue below -->
    </includes>
  </release>
</grit>